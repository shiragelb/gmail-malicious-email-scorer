# Copy to .env and fill in the keys you have.

# Local: true. Cloud Run: false (requires auth secrets below).
DEV_MODE=true
LOG_LEVEL=

# Protects POST /v1/analyze. Required outside DEV_MODE unless ACCOUNT_TOKEN_SECRET is set.
API_KEY=
# Comma-separated extra keys (manual per-user tokens).
API_KEYS=
# Optional file with one key per line.
API_KEYS_FILE=

# HMAC request signing (required outside DEV_MODE). Same value in Apps Script Script property.
REQUEST_SIGNING_SECRET=
SIGNATURE_MAX_AGE_SECONDS=300
MAX_REQUEST_BYTES=12582912
RATE_LIMIT_PER_MINUTE=30

# Firebase Auth → /v1/account/token (optional). Minted keys look like mg1.<uid>.<hmac>
FIREBASE_PROJECT_ID=
ACCOUNT_TOKEN_SECRET=

# Layer 4 meta-analyst. When empty, a local correlator produces the verdict.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_MODE=redacted
LLM_SKIP_SENDERS=

# Layer 2 feeds
URLHAUS_AUTH_KEY=
PHISHTANK_API_KEY=
SAFE_BROWSING_API_KEY=

ENABLE_LIVE_DNS=false
ENABLE_WHOIS=true
ENABLE_DOMAIN_AGE=true
USE_TRANSFORMERS=false
TRANSFORMER_MODEL=ealvaradob/bert-finetuned-phishing
# Optional local ONNX files. Production uses the Hugging Face Inference API instead.
USE_ONNX_CLASSIFIER=false
ONNX_MODEL_DIR=
ONNX_INFERENCE_TIMEOUT_MS=500
USE_HF_CLASSIFIER=true
HF_TOKEN=
HF_PHISHING_MODEL=aamoshdahal/email-phishing-distilbert-finetuned
HF_INJECTION_MODEL=protectai/deberta-v3-small-prompt-injection-v2
HF_CLASSIFIER_TIMEOUT_MS=1500

# Per-instance estimated spend for Claude and VirusTotal. Local ONNX is not paused.
BUDGET_USD_PER_DAY=1
CLAUDE_INPUT_USD_PER_MILLION=3
CLAUDE_OUTPUT_USD_PER_MILLION=15
DEEP_SCAN_USD_PER_URL=0.02
ONNX_USD_PER_CALL=0

# User-triggered URL reputation. Off the Gmail sidebar fast path until a VirusTotal key is set.
ENABLE_DEEP_SCAN=true
ENABLE_SANDBOX=true
SANDBOX_WAIT_SECONDS=0
SANDBOX_MAX_FILES=2
VIRUSTOTAL_API_KEY=
DEEP_SCAN_MALICIOUS_THRESHOLD=3
DEEP_SCAN_MAX_URLS=3
DEEP_SCAN_PER_HOUR=6
